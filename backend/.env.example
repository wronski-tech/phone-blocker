# Domain whose DNS A/AAAA record points at this server; Caddy gets its HTTPS certificate.
DOMAIN=phone-blocker.example.com
# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD=
API_TOKEN=
BLOCK_THRESHOLD=1
# Optional: sole traders from CEIDG. Get a free token at https://dane.biznes.gov.pl
# ("Dane po API"), then set both lines to start the ceidg container.
CEIDG_TOKEN=
COMPOSE_PROFILES=
# Optional: push alerts for failed imports and backups. Pick a hard-to-guess topic, e.g.
# https://ntfy.sh/phone-blocker-<openssl rand -hex 8>, and subscribe to it in the ntfy app.
NTFY_URL=
NTFY_TOKEN=
